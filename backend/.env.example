# 复制本文件为 backend/.env 并填写真实值（.env 已由 .gitignore 忽略，不会提交）

# Redis（检查点 / 会话 / RAG 向量库）
REDIS_URL = 'redis://localhost:26379'

# Web 服务（实际监听由 uvicorn 启动参数决定）
API_HOST = '127.0.0.1'
API_PORT = '8080'
# 允许的跨域来源（逗号分隔）
CORS_ORIGINS = 'http://localhost:5173,http://127.0.0.1:5173'

# 本地 Ollama 通道（route_model / chat_model 设为 local 时生效）
ollama_model = 'qwen3.5:4b'
ollama_url = 'http://localhost:11434'
embeddings_model = 'qwen3-embedding:latest'
ollama_reasoning = 'false'
ollama_temperature = 0.7

# 路由意图分类 / 对话模型通道：cloud = 云端（默认）；local = 本地 Ollama
route_model = 'cloud'
chat_model = 'cloud'

# 主图超参数（均有代码默认值，可不配置）
SUMMARY_THRESHOLD_TOKENS = '4096'   # 超过阈值时对旧消息摘要压缩
SUMMARY_KEEP_RECENT = '5'           # 摘要时保留最近 N 条原文
MAX_ERROR = '3'                     # 失败重试 / 重规划总预算
MAX_INTERRUPT = '3'                 # 缺数据请教的最多次数
MAX_FEEDBACK = '2'                  # 汇总验收最多轮数
MAX_TASK_RETRY = '1'                # 单次派发内有限重试（仅临时故障）
SUBAGENT_TIMEOUT = '120'            # 单个子代理执行超时（秒）
MCP_TOOL_TIMEOUT = '45'             # 单个 MCP 工具调用超时（秒），远端挂起时快速失败

# ===== 认证与会话安全（api.py）=====
# 置 0 退回"客户端 username"的开发模式，生产必须保持 1
AUTH_ENABLED = '1'
# Token 签名密钥；缺省回退 APP_PASSWORD
AUTH_SECRET = ''
APP_USERNAME = 'admin'
APP_PASSWORD = 'admin'
TOKEN_TTL = '86400'                 # Token 有效期（秒）
RATE_LIMIT_PER_MINUTE = '30'        # 每用户每分钟回答请求上限（Redis 可用时跨进程生效）
MAX_QUESTION_CHARS = '2000'         # 单条问题长度上限（api.py）
MAX_RESUME_CHARS = '1000'           # interrupt 补充信息长度上限
GRAPH_RECURSION_LIMIT = '60'        # 主图单轮最大 superstep 数

# ===== 意图路由 =====
ROUTER_ENABLED = '1'                # 关闭后一律走完整规划
ROUTER_MIN_CONFIDENCE = '0.7'       # 路由模型置信度低于该值一律回退完整规划

# ===== 结果时效（planning.py）：超过有效期的实时结果不再跨规划复用 =====
RESULT_TTL_WEATHER = '900'
RESULT_TTL_TRAVEL = '600'
RESULT_TTL_FOOD = '86400'
RESULT_TTL_DEFAULT = '3600'

# ===== 气象知识检索（subagent/weather.py）=====
RAG_TIMEOUT = '15'                  # 单次检索超时（秒），超时降级为仅使用工具
RAG_CACHE_TTL = '1800'              # 知识检索缓存有效期（秒）
RAG_CACHE_MAX = '64'                # 缓存条目上限

# ===== RAG 检索（backend/rag.py）=====
# 向量索引名（同一 Redis 实例内区分不同语料）
RAG_INDEX_NAME = 'weather'
# 向量粗排召回的候选子块数（供 cross-encoder 精排）
RAG_RECALL_K = '40'
# 精排后最终返回的父块（页）数
RAG_TOP_N = '3'
# 子块大小 / 重叠（字符数），页内切分，仅用于召回与重排
RAG_CHILD_SIZE = '500'
RAG_CHILD_OVERLAP = '80'
# 写入向量库的批量大小
RAG_BATCH_SIZE = '20'
# 本地 cross-encoder 重排模型
RAG_RERANK_MODEL = 'BAAI/bge-reranker-base'
# 重排分数阈值（0~1）；留空表示不做硬过滤，按重排顺序取 Top-N
RAG_RERANK_THRESHOLD = ''
# 单次检索拼进提示词的最大字符数
RAG_MAX_CONTEXT_CHARS = '10000'
# 单个父块（页）最多截取的字符数
RAG_PARENT_MAX_CHARS = '3500'
# 同一来源（PDF）最多返回的页数，避免单本书连续多页垄断
RAG_MAX_PAGES_PER_SOURCE = '2'
# 邻页扩展：命中子块靠近页边界时补充邻页摘录，0 表示关闭
RAG_NEIGHBOR_PAGES = '0'
RAG_NEIGHBOR_CHARS = '300'
# 判定“靠近页边界”的字符距离
RAG_EDGE_CHARS = '120'
# 仅运行 rag.py 时生效；置 1 会全量删除索引（慎用）
# RAG_REBUILD = '0'

# 云端模型（OpenAI 兼容）
model = 'deepseek-v4-flash'
model_provider = 'openai'
model_api = 'sk-YOUR_API_KEY'
base_url = 'https://opencode.ai/zen/go/v1'

# 本地 MCP 工具服务器（weather / food）的环境变量各自独立，见 tool/.env.example