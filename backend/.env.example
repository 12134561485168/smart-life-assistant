# 复制本文件为 backend/.env 并填写真实值（.env 已由 .gitignore 忽略，不会提交）

# Redis（检查点持久化 / 会话密钥 / 撤销标记 / RAG 向量库）
REDIS_URL = 'redis://localhost:26379'

# Web 服务（api.py 读取；实际监听端口由 uvicorn 启动参数决定）
API_HOST = '127.0.0.1'
API_PORT = '8080'
# 允许的跨域来源（逗号分隔），供前端 dev server 直接调用
CORS_ORIGINS = 'http://localhost:5173,http://127.0.0.1:5173'

# 本地 Ollama 通道（route_model / chat_model 设为 local 时生效）
ollama_model = 'qwen3.5:4b'
ollama_url = 'http://localhost:11434'
embeddings_model = 'qwen3-embedding:latest'
ollama_reasoning = 'false'
ollama_temperature = 0.7

# 路由意图分类 / 对话模型通道：cloud = 云端（默认）；local = 本地 Ollama
route_model = 'cloud'
chat_model = 'cloud'

# 主图超参数（agent.py，均已带代码默认值，可不配置）
SUMMARY_THRESHOLD_TOKENS = '4096'   # 消息 token 数超过阈值时，对旧消息做摘要压缩
SUMMARY_KEEP_RECENT = '5'           # 摘要压缩时强制保留最近 N 条原文
MAX_ERROR = '3'                     # 子任务失败回 plan 重规划的最多次数
MAX_INTERRUPT = '3'                 # 缺数据请教（interrupt）的最多次数
MAX_FEEDBACK = '2'                  # 汇总验收不过回 plan 重规划的最多次数（达上限自动放行）

# 云端模型（OpenAI 兼容）
model = 'deepseek-v4-flash'
model_provider = 'openai'
model_api = 'sk-YOUR_API_KEY'
base_url = 'https://opencode.ai/zen/go/v1'

# ---- 本地 MCP 工具服务器（tool/）----
# weather（open-meteo 天气 + 高德地理编码）
weather_host = '127.0.0.1'
weather_port = '8000'
amap_key = ''            # 高德开放平台 Web 服务 Key（用于地理编码解析地址）

# food（TheMealDB 菜谱）
food_host = '127.0.0.1'
food_port = '8002'       # 与 backend/mcp.json 中 meal 端点保持一致
API_BASE_URL = 'https://www.themealdb.com/api/json/v1'
THEMEALDB_API_KEY = '1'  # 线上请换成真实 Key（默认测试 Key '1'）