# 复制本文件为 tool/.env 并填写真实值（.env 已由 .gitignore 忽略，不会提交）。
# 本文件是 tool 目录（本地 MCP 工具服务器）的配置示例；
# backend 自身配置见 backend/.env.example，两者相互独立。

# ---------- 天气工具（tool/weather.py）----------
# open-meteo 天气 + 高德地理编码
weather_host = '127.0.0.1'
weather_port = '8000'        # 与 backend/mcp.json 中 weather 端点保持一致
amap_key = ''                # 高德开放平台 Web 服务 Key（用于地址→经纬度解析）；留空则地址解析能力受限

# ---------- 美食工具（tool/food.py）----------
# TheMealDB 菜谱
food_host = '127.0.0.1'
food_port = '8002'           # 与 backend/mcp.json 中 meal 端点保持一致
API_BASE_URL = 'https://www.themealdb.com/api/json/v1'
THEMEALDB_API_KEY = '1'  # TheMealDB 公开测试 Key（'1' 即为官方默认，可直接使用）